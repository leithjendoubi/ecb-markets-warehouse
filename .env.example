# Copy to .env (git-ignored):  cp .env.example .env
# Every value here is for the LOCAL Docker stack only. Change the passwords if the machine is shared.

COMPOSE_PROJECT_NAME=ecbwh

# --- PostgreSQL 16 (one instance: airflow metadata, metabase app db, warehouse) ---
POSTGRES_SUPERUSER_PASSWORD=local-postgres-pw
AIRFLOW_DB_PASSWORD=local-airflow-db-pw
METABASE_DB_PASSWORD=local-metabase-db-pw
# Warehouse owner (loader + dbt) and Metabase read-only user (reads marts only)
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=local-warehouse-pw
WAREHOUSE_RO_USER=metabase_ro
WAREHOUSE_RO_PASSWORD=local-metabase-ro-pw
# Host-side connection (tests, dbt from the host). Containers override HOST/PORT to postgres:5432.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432

# --- SeaweedFS S3 API (credentials are rendered into infra/s3.json at container start) ---
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=local-access-key
S3_SECRET_KEY=local-secret-key-change-me
S3_BUCKET=ecb-lake
S3_REGION=us-east-1
S3_PORT=8333

# --- ECB Data Portal (public, no API key) ---
ECB_BASE_URL=https://data-api.ecb.europa.eu/service
ECB_TIMEOUT_SECONDS=120

# --- Airflow 3 ---
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=local-airflow-admin-pw
AIRFLOW_JWT_SECRET=local-jwt-secret-change-me-0123456789abcdef
# Optional: leave empty for local use (no Airflow connections are stored).
AIRFLOW_FERNET_KEY=

# --- Metabase ---
METABASE_PORT=3000

# --- Metabase admin (created by `make dashboard` on first run; local only) ---
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=local-metabase-admin-pw1
